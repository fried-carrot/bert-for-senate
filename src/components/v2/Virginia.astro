---
---

<section class="va section" id="virginia">
  <div class="va__scene" aria-hidden="true">
    <svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMax slice" class="va__svg">
      <defs>
        <linearGradient id="va-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#161a21" />
          <stop offset="0.62" stop-color="#1d2129" />
          <stop offset="0.86" stop-color="#2c2a26" />
          <stop offset="1" stop-color="#3a3020" />
        </linearGradient>
        <radialGradient id="va-glow" cx="0.62" cy="0.92" r="0.55">
          <stop offset="0" stop-color="#c79653" stop-opacity="0.55" />
          <stop offset="0.4" stop-color="#a8763d" stop-opacity="0.22" />
          <stop offset="1" stop-color="#a8763d" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="va-mist" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#cdbfa6" stop-opacity="0.10" />
          <stop offset="1" stop-color="#cdbfa6" stop-opacity="0" />
        </linearGradient>
      </defs>

      <rect width="1440" height="620" fill="url(#va-sky)" />
      <ellipse cx="900" cy="600" rx="780" ry="300" fill="url(#va-glow)" />

      <!-- far ridge -->
      <path d="M0,402 C200,360 380,412 560,384 C760,352 940,348 1120,392 C1300,432 1390,372 1440,390 L1440,620 L0,620 Z"
            fill="#262d37" opacity="0.85" />
      <rect x="0" y="402" width="1440" height="80" fill="url(#va-mist)" />
      <!-- mid ridge -->
      <path d="M0,472 C240,430 430,492 640,458 C860,422 1040,506 1240,462 C1360,436 1410,470 1440,468 L1440,620 L0,620 Z"
            fill="#1b212b" />
      <rect x="0" y="470" width="1440" height="70" fill="url(#va-mist)" opacity="0.7" />
      <!-- near ridge -->
      <path d="M0,540 C260,506 520,552 760,524 C980,500 1200,560 1440,520 L1440,620 L0,620 Z"
            fill="#12161d" />
    </svg>
    <span class="va__scrim"></span>
  </div>

  <div class="wrap va__inner rise">
    <p class="label va__eyebrow">The Commonwealth</p>
    <blockquote class="va__quote">
      From the Blue Ridge to the Tidewater, this is the ground that raised me.
      I will defend it in the Senate the way I defended this country in uniform
      &mdash; <em>without apology, and without quit.</em>
    </blockquote>
    <p class="va__sign">
      <span>Bert Mizusawa</span>
      Maj. Gen., U.S. Army (Ret.) &middot; Candidate for U.S. Senate
    </p>
  </div>
</section>

<style>
  .va {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; align-items: center;
    min-height: clamp(560px, 82vh, 820px);
    text-align: center;
  }
  .va__scene { position: absolute; inset: 0; z-index: -1; }
  .va__svg { width: 100%; height: 100%; object-fit: cover; }
  .va__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 30%, oklch(0.16 0.016 256 / 0.35), oklch(0.13 0.014 256 / 0.78)),
      linear-gradient(180deg, var(--bg) 0%, transparent 22%, transparent 72%, var(--bg) 100%);
  }

  .va__inner { max-width: 920px; }
  .va__eyebrow { color: var(--brass); }
  .va__quote {
    font-family: var(--font-body); font-weight: 400;
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3rem);
    line-height: 1.3; color: var(--bone);
    margin: 1.5rem auto 2rem; max-width: 22ch; text-wrap: balance;
  }
  .va__quote em { font-style: italic; color: var(--brass-bright); }
  .va__sign {
    font-family: var(--font-ui); font-weight: 500;
    font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted); line-height: 1.7;
  }
  .va__sign span {
    display: block; color: var(--bone);
    font-family: var(--font-display); font-weight: 700; font-stretch: 112%;
    font-size: 1.1rem; letter-spacing: 0.04em; margin-bottom: 0.4rem;
  }
</style>
