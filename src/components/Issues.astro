---
const issues = [
  { title: 'Secure the Border', body: 'Back the rule of law and the men and women who enforce it. A nation without borders is no nation at all.' },
  { title: 'Lower Taxes, Real Growth', body: 'Let Virginians keep more of what they earn. Cut the waste and unleash small business and working families.' },
  { title: 'A Strong Defense', body: 'Fund the military, stand by our veterans, and confront the adversaries who threaten American freedom.' },
  { title: 'Energy Independence', body: 'Power the Commonwealth with affordable, reliable American energy, not foreign suppliers.' },
  { title: 'Defend Our Freedoms', body: 'Protect the constitutional rights of every citizen, from free speech to the Second Amendment.' },
  { title: 'Honor Our Veterans', body: 'Deliver the healthcare, respect, and opportunity our servicemembers earned. No one left behind.' },
];
---

<section class="plat section" id="issues">
  <span class="plat__halftone" aria-hidden="true"></span>
  <div class="container--wide plat__inner">
    <div class="plat__head">
      <p class="eyebrow eyebrow--cream" data-reveal>The Platform</p>
      <h2 class="poster plat__title" data-reveal data-reveal-delay="1">Where I Stand</h2>
      <p class="lede plat__intro" data-reveal data-reveal-delay="2">
        Six planks for Virginia, grounded in the same duty that guided a lifetime
        in uniform. No equivocation. No fine print.
      </p>
      <div class="rule-stars plat__stars" data-reveal data-reveal-delay="2" aria-hidden="true">
        &#9733;&#9733;&#9733;
      </div>
    </div>

    <ol class="plat__grid">
      {issues.map((it, i) => (
        <li class="plank" data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <span class="plank__no">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="plank__title">{it.title}</h3>
          <p class="plank__body">{it.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .plat {
    position: relative;
    background: var(--ink);
    color: var(--on-ink);
    overflow: hidden;
  }
  .plat__halftone {
    position: absolute; inset: 0;
    color: rgba(241,230,205,0.06);
    background-image: radial-gradient(currentColor 1.4px, transparent 1.6px);
    background-size: 12px 12px;
  }
  .plat__inner { position: relative; }

  .plat__head { text-align: center; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .plat__head .eyebrow { justify-content: center; }
  .plat__title {
    font-size: clamp(2.8rem, 1.6rem + 6vw, 6rem);
    color: var(--paper);
    text-shadow: 4px 4px 0 var(--ox);
    margin: 0.85rem 0 1.1rem;
  }
  .plat__intro { color: var(--on-ink-soft); max-width: 50ch; margin-inline: auto; }
  .plat__stars { color: var(--ochre-2); justify-content: center; max-width: 320px; margin: 1.5rem auto 0; }

  .plat__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--line-cream);
    border-left: 2px solid var(--line-cream);
  }
  .plank {
    position: relative;
    border-right: 2px solid var(--line-cream);
    border-bottom: 2px solid var(--line-cream);
    padding: 2rem 1.85rem 2.25rem;
    transition: background 0.25s var(--ease);
  }
  .plank::before {
    content: ""; position: absolute; left: 0; top: 0; height: 4px; width: 0;
    background: var(--ox);
    transition: width 0.3s var(--ease);
  }
  .plank:hover { background: rgba(241,230,205,0.04); }
  .plank:hover::before { width: 100%; }

  .plank__no {
    font-family: var(--font-poster);
    font-size: 2.2rem; line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ochre);
    display: block; margin-bottom: 0.9rem;
  }
  .plank__title {
    font-family: var(--font-condensed); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.02em;
    font-size: 1.34rem; line-height: 1.05;
    color: var(--paper); margin-bottom: 0.6rem;
  }
  .plank__body { color: var(--on-ink-soft); font-size: 0.97rem; }

  @media (max-width: 880px) {
    .plat__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .plat__grid { grid-template-columns: 1fr; }
  }
</style>
