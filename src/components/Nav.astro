---
const links = [
  { href: '#about', label: 'The Record' },
  { href: '#issues', label: 'The Platform' },
  { href: '#vision', label: 'The Pledge' },
  { href: '#act', label: 'Enlist' },
];
const donate = 'https://secure.winred.com/';
---

<header class="mast" data-nav>
  <div class="mast__edition">
    <div class="container--wide mast__edition-row">
      <span>Est. 2026</span>
      <span class="mast__edition-mid">&#9733; The Commonwealth of Virginia &#9733;</span>
      <span>No. I</span>
    </div>
  </div>

  <div class="container--wide mast__bar">
    <a href="#top" class="mast__brand" aria-label="Bert Mizusawa for U.S. Senate — home">
      <span class="mast__seal" aria-hidden="true">&#9733;&#9733;</span>
      <span class="mast__brand-text">
        <strong>BERT MIZUSAWA</strong>
        <em>For United States Senate</em>
      </span>
    </a>

    <nav class="mast__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="mast__cta">
      <a href={donate} class="btn btn--sm" target="_blank" rel="noopener">Donate</a>
      <button class="mast__toggle" data-toggle aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mast__mobile" data-mobile hidden>
    {links.map((l) => <a href={l.href} data-mobile-link>{l.label}</a>)}
    <a href={donate} class="btn" target="_blank" rel="noopener">Donate Now</a>
  </div>
</header>

<style>
  .mast {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 3px solid var(--ink);
    box-shadow: 0 1px 0 1px var(--ink), 0 6px 14px -10px rgba(15,22,38,0.5);
  }

  .mast__edition {
    background: var(--ink);
    color: var(--on-ink-soft);
    border-bottom: 1px solid var(--line-cream);
  }
  .mast__edition-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 30px;
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .mast__edition-mid { color: var(--ochre-2); }

  .mast__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 70px;
  }

  .mast__brand { display: flex; align-items: center; gap: 0.85rem; }
  .mast__seal {
    display: grid; place-items: center;
    width: 40px; height: 40px;
    background: var(--ox);
    color: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-size: 0.85rem;
    letter-spacing: -2px;
    transform: rotate(-3deg);
  }
  .mast__brand-text { display: flex; flex-direction: column; line-height: 1; }
  .mast__brand-text strong {
    font-family: var(--font-condensed);
    font-weight: 900;
    font-size: 1.32rem;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .mast__brand-text em {
    font-style: normal;
    font-family: var(--font-condensed);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ox);
    margin-top: 3px;
  }

  .mast__links { display: flex; gap: 1.9rem; }
  .mast__links a {
    font-family: var(--font-condensed);
    font-weight: 700;
    font-size: 0.96rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    position: relative;
    padding: 0.3rem 0;
  }
  .mast__links a::after {
    content: "";
    position: absolute; left: 0; right: 100%; bottom: -1px;
    height: 2px; background: var(--ox);
    transition: right 0.25s var(--ease);
  }
  .mast__links a:hover { color: var(--ox); }
  .mast__links a:hover::after { right: 0; }

  .mast__cta { display: flex; align-items: center; gap: 0.85rem; }

  .mast__toggle {
    display: none;
    width: 42px; height: 42px;
    background: transparent;
    border: 2px solid var(--ink);
    flex-direction: column;
    align-items: center; justify-content: center;
    gap: 5px;
  }
  .mast__toggle span { width: 18px; height: 2px; background: var(--ink); transition: transform 0.25s var(--ease), opacity 0.2s var(--ease); }
  .mast__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mast__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .mast__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mast__mobile {
    display: none;
    flex-direction: column;
    padding: 0.5rem var(--gutter) 1.4rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .mast__mobile a:not(.btn) {
    font-family: var(--font-condensed);
    font-weight: 700;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .mast__mobile .btn { margin-top: 1rem; justify-content: center; }

  @media (max-width: 900px) {
    .mast__links { display: none; }
    .mast__toggle { display: flex; }
    .mast__mobile[data-open] { display: flex; }
  }
  @media (max-width: 440px) {
    .mast__cta .btn--sm { display: none; }
    .mast__brand-text strong { font-size: 1.12rem; }
  }
</style>

<script>
  const toggle = document.querySelector('[data-toggle]');
  const mobile = document.querySelector('[data-mobile]');
  if (toggle && mobile) {
    const close = () => {
      mobile.removeAttribute('data-open');
      mobile.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      if (mobile.hasAttribute('data-open')) { close(); }
      else {
        mobile.setAttribute('data-open', '');
        mobile.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
    mobile.querySelectorAll('[data-mobile-link]').forEach((l) => l.addEventListener('click', close));
  }
</script>
