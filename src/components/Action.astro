---
const base = import.meta.env.BASE_URL;
const donate = 'https://secure.winred.com/bert-for-senate/donate-today';
const amounts = ['25', '50', '100', '250'];
---

<section class="enlist section" id="act">
  <span class="enlist__halftone" aria-hidden="true"></span>
  <div class="container--wide enlist__grid">
    <div class="enlist__lead" data-reveal>
      <p class="eyebrow eyebrow--cream">Join the Ranks</p>
      <h2 class="poster enlist__title">Virginia<br />Needs<br /><span>You.</span></h2>
      <p class="lede enlist__lede">
        This campaign is powered by Virginians who refuse to sit on the sidelines.
        Step forward, volunteer, and help send proven leadership to the Senate.
      </p>
      <div class="enlist__cta">
        <a href={`${base}volunteer`} class="btn btn--cream">Volunteer Today</a>
        <a href="mailto:info@bertforsenate.com" class="btn btn--ghost-cream">Contact the Team</a>
      </div>
    </div>

    <div class="bond" data-reveal data-reveal-delay="1">
      <div class="bond__head">
        <span class="bond__chip">&#9733; Contribution &#9733;</span>
        <h3 class="bond__title">Chip In to the Cause</h3>
        <p class="bond__sub">Every dollar puts boots on the ground across the Commonwealth.</p>
      </div>
      <div class="bond__perf" aria-hidden="true"></div>
      <div class="bond__amounts">
        {amounts.map((a) => (
          <a href={donate} target="_blank" rel="noopener" class="bond__amt">
            <span>$</span>{a}
          </a>
        ))}
      </div>
      <a href={donate} target="_blank" rel="noopener" class="btn bond__go">
        Donate Now <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <p class="bond__fine">Secure contribution processed by WinRed.</p>
    </div>
  </div>
</section>

<style>
  .enlist {
    position: relative;
    background: var(--ox);
    color: var(--paper);
    overflow: hidden;
    border-top: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
  }
  .enlist__halftone {
    position: absolute; inset: 0;
    color: rgba(15,22,38,0.16);
    background-image: radial-gradient(currentColor 1.5px, transparent 1.7px);
    background-size: 10px 10px;
  }
  .enlist__grid {
    position: relative;
    display: grid; grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .enlist__title {
    font-size: clamp(3rem, 1.8rem + 7vw, 6.5rem);
    color: var(--paper);
    text-shadow: 5px 5px 0 var(--ink);
    margin: 0.85rem 0 1.5rem;
  }
  .enlist__title span { color: var(--ochre-2); }
  .enlist__lede { color: rgba(241,230,205,0.92); max-width: 42ch; }
  .enlist__cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

  /* War-bond ticket */
  .bond {
    background: var(--paper);
    color: var(--ink-text);
    border: 3px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink-2);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    position: relative;
  }
  .bond::before {
    content: ""; position: absolute; inset: 8px;
    border: 1px dashed var(--line-strong); pointer-events: none;
  }
  .bond__head { position: relative; }
  .bond__chip {
    display: inline-block;
    font-family: var(--font-condensed); font-weight: 800;
    font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--paper); background: var(--ox);
    padding: 0.3rem 0.7rem; border: 2px solid var(--ink);
    margin-bottom: 1rem;
  }
  .bond__title {
    font-family: var(--font-poster);
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.3rem);
    color: var(--ink); line-height: 0.95; text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .bond__sub { color: var(--ink-text); font-size: 0.95rem; }
  .bond__perf {
    height: 0; border-top: 2px dashed var(--line-strong);
    margin: 1.4rem 0;
  }
  .bond__amounts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-bottom: 1rem; }
  .bond__amt {
    font-family: var(--font-poster);
    font-size: 1.5rem; text-align: center;
    padding: 0.7rem 0.2rem;
    border: 2px solid var(--ink); color: var(--ink);
    background: var(--paper);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.12s var(--ease), box-shadow 0.12s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
  }
  .bond__amt span { font-size: 0.85rem; vertical-align: 0.35em; margin-right: 1px; }
  .bond__amt:hover { background: var(--ox); color: var(--paper); transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--ink); }
  .bond__go { width: 100%; justify-content: center; position: relative; }
  .bond__fine {
    text-align: center; font-family: var(--font-condensed); font-weight: 600;
    font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-text); margin-top: 0.9rem; opacity: 0.8;
  }

  @media (max-width: 880px) {
    .enlist__grid { grid-template-columns: 1fr; }
  }
</style>
