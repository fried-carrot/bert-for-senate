---
const donate = 'https://secure.winred.com/';
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__stars"></span>
    <span class="hero__glow"></span>
  </div>

  <div class="container--wide hero__grid">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--light hero__eyebrow">Virginia &middot; U.S. Senate 2026</p>

      <h1 class="display hero__title">
        <span class="hero__line">Service</span>
        <span class="hero__line">Before</span>
        <span class="hero__line hero__line--accent">Self.</span>
      </h1>

      <p class="lede hero__lede">
        Maj. Gen. <strong>Bert Mizusawa</strong> spent a lifetime defending this
        country. Now he is fighting to protect Virginia's values and secure
        America's future in the United States Senate.
      </p>

      <div class="hero__actions">
        <a href="#issues" class="btn">
          See Where I Stand
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href={donate} class="btn btn--on-navy" target="_blank" rel="noopener">
          Join the Campaign
        </a>
      </div>

      <ul class="hero__creds">
        <li><span>34+</span> Years of Service</li>
        <li><span>2&#9733;</span> Major General, U.S. Army</li>
        <li><span>VA</span> Lifelong Virginian</li>
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__frame">
        <img
          src="/img/candidate.jpg"
          alt="Major General Bert Mizusawa in U.S. Army dress uniform before the American flag"
          width="1536"
          height="1920"
          fetchpriority="high"
        />
        <span class="hero__tag">
          <strong>MAJ. GEN. BERT MIZUSAWA</strong>
          <em>U.S. Army, Retired</em>
        </span>
      </div>
      <span class="hero__badge" aria-hidden="true">
        <span class="hero__badge-star">&#9733;&#9733;</span>
      </span>
    </div>
  </div>

  <div class="stripe-rule hero__stripe" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(160deg, var(--ink) 0%, var(--navy) 58%, var(--navy-700) 100%);
    color: var(--on-navy);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg { position: absolute; inset: 0; z-index: -1; }
  .hero__stars {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.10) 1px, transparent 1.4px);
    background-size: 30px 30px;
    mask-image: linear-gradient(to bottom, black, transparent 70%);
    opacity: 0.5;
  }
  .hero__glow {
    position: absolute;
    top: -20%; right: -10%;
    width: 60vw; height: 60vw; max-width: 720px; max-height: 720px;
    background: radial-gradient(circle, rgba(200,16,46,0.32), transparent 62%);
    filter: blur(10px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(4rem, 8vw, 7rem);
    min-height: min(86vh, 880px);
  }

  .hero__eyebrow {
    opacity: 0;
    animation: rise 0.7s var(--ease) 0.05s forwards;
  }
  .hero__title {
    font-size: clamp(3.4rem, 2rem + 9vw, 8.5rem);
    color: var(--white);
    margin: 1.1rem 0 1.5rem;
  }
  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(40px);
    animation: rise 0.85s var(--ease) forwards;
  }
  .hero__line:nth-child(1) { animation-delay: 0.12s; }
  .hero__line:nth-child(2) { animation-delay: 0.22s; }
  .hero__line--accent {
    color: var(--red);
    -webkit-text-stroke: 0;
    animation-delay: 0.32s;
    position: relative;
  }
  .hero__lede {
    color: var(--on-navy-soft);
    max-width: 38ch;
    opacity: 0;
    animation: rise 0.8s var(--ease) 0.42s forwards;
  }
  .hero__lede strong { color: var(--white); font-weight: 700; }

  .hero__actions {
    display: flex; flex-wrap: wrap; gap: 0.9rem;
    margin-top: 2rem;
    opacity: 0;
    animation: rise 0.8s var(--ease) 0.52s forwards;
  }

  .hero__creds {
    list-style: none; padding: 0;
    display: flex; flex-wrap: wrap; gap: 2rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--on-navy-line);
    opacity: 0;
    animation: rise 0.8s var(--ease) 0.62s forwards;
  }
  .hero__creds li {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-navy-soft);
    line-height: 1.3;
    max-width: 9rem;
  }
  .hero__creds span {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--gold);
    letter-spacing: 0;
    margin-bottom: 0.25rem;
  }

  /* Media */
  .hero__media {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 460px;
    opacity: 0;
    animation: fade 1s var(--ease) 0.3s forwards;
  }
  .hero__frame {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--on-navy-line);
    transform: translateZ(0);
  }
  .hero__frame::before {
    content: "";
    position: absolute; inset: 0; z-index: 2;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
    pointer-events: none;
  }
  .hero__frame img {
    width: 100%; height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .hero__tag {
    position: absolute;
    left: 0; bottom: 0; z-index: 3;
    display: flex; flex-direction: column;
    gap: 2px;
    padding: 0.85rem 1.1rem;
    background: color-mix(in srgb, var(--ink) 82%, transparent);
    backdrop-filter: blur(6px);
    border-top-right-radius: 6px;
    border-top: 2px solid var(--red);
  }
  .hero__tag strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--white);
  }
  .hero__tag em {
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .hero__badge {
    position: absolute;
    top: -22px; right: -22px;
    width: 88px; height: 88px;
    display: grid; place-items: center;
    background: var(--red);
    border-radius: 50%;
    box-shadow: 0 12px 30px -8px rgba(200,16,46,0.7), inset 0 0 0 2px rgba(255,255,255,0.25);
    border: 3px solid var(--ink);
  }
  .hero__badge-star {
    color: var(--white);
    letter-spacing: -2px;
    font-size: 1.1rem;
  }

  .hero__stripe { position: absolute; bottom: 0; left: 0; }

  @keyframes rise {
    to { opacity: 1; transform: none; }
  }
  @keyframes fade { to { opacity: 1; } }

  @media (max-width: 940px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: left;
    }
    .hero__media {
      justify-self: start;
      max-width: 360px;
      order: -1;
    }
    .hero__lede { max-width: 52ch; }
  }
  @media (max-width: 560px) {
    .hero__creds { gap: 1.25rem; }
    .hero__creds li { max-width: 7.5rem; }
    .hero__badge { width: 68px; height: 68px; top: -16px; right: -16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow, .hero__line, .hero__lede, .hero__actions,
    .hero__creds, .hero__media { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>
