---
const points = [
  { title: 'Proven Leadership', body: 'Rose to Major General over a thirty-four year career, leading soldiers in service to the nation, not slogans on a campaign trail.' },
  { title: 'Virginia Values', body: 'Anchored in faith, family, and the freedom of every citizen to build a life on their own terms.' },
  { title: 'Conservative Vision', body: 'Lower taxes, limited government, and individual liberty, so opportunity is earned and protected for the next generation.' },
];
---

<section class="rec section" id="about">
  <div class="container--wide rec__head" data-reveal>
    <p class="eyebrow eyebrow--ink">The Record</p>
    <h2 class="headline rec__title">Leadership Earned <span>The Hard Way</span></h2>
    <hr class="rule-double rec__rule" />
  </div>

  <div class="container--wide rec__grid">
    <figure class="rec__media" data-reveal>
      <div class="rec__frame">
        <img src="/img/ceremony.jpg" alt="Bert Mizusawa speaking at a military ceremony"
             width="1400" height="931" loading="lazy" />
      </div>
      <span class="rec__stamp" aria-hidden="true">
        <strong>34</strong><em>Years of<br />Service</em>
      </span>
      <figcaption>Maj. Gen. Mizusawa addresses servicemembers at a ceremony.</figcaption>
    </figure>

    <div class="rec__body">
      <p class="rec__intro" data-reveal>
        <span class="rec__dropcap">D</span>ecades of service to our nation taught Bert
        Mizusawa that real leadership is measured by results and sacrifice, not by
        applause. He carried that conviction from the battlefield to the boardroom,
        and now to the fight for Virginia families.
      </p>

      <ul class="rec__points">
        {points.map((p, i) => (
          <li class="rec__point" data-reveal data-reveal-delay={String(i + 1)}>
            <span class="rec__point-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .rec { background: var(--paper); position: relative; }

  .rec__head { text-align: center; margin-bottom: clamp(2.25rem, 4vw, 3.5rem); }
  .rec__head .eyebrow { justify-content: center; }
  .rec__title {
    font-size: clamp(2.3rem, 1.4rem + 4vw, 4.5rem);
    color: var(--ink);
    margin: 0.75rem 0 1.25rem;
  }
  .rec__title span { color: var(--ox); }
  .rec__rule { width: min(420px, 70%); margin-inline: auto; }

  .rec__grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .rec__media { position: relative; margin: 0; }
  .rec__frame {
    border: 3px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
    background: var(--ink);
    overflow: hidden;
  }
  .rec__frame img {
    width: 100%; aspect-ratio: 3 / 2; object-fit: cover;
    filter: url(#duotone-ink) contrast(1.05);
  }
  .rec__stamp {
    position: absolute; top: -22px; right: -18px;
    width: 96px; height: 96px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: var(--ox); color: var(--paper);
    border-radius: 50%;
    border: 3px solid var(--paper);
    box-shadow: 0 0 0 3px var(--ink);
    transform: rotate(7deg);
    text-align: center;
  }
  .rec__stamp strong { font-family: var(--font-poster); font-size: 1.9rem; line-height: 0.9; }
  .rec__stamp em {
    font-style: normal; font-family: var(--font-condensed); font-weight: 700;
    font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.1;
    margin-top: 2px;
  }
  .rec__media figcaption {
    font-family: var(--font-body); font-style: italic;
    font-size: 0.85rem; color: var(--ink-text);
    margin-top: 1.4rem; padding-left: 0.9rem;
    border-left: 3px solid var(--ox);
    max-width: 36ch;
  }

  .rec__intro { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.32rem); line-height: 1.55; }
  .rec__dropcap {
    float: left;
    font-family: var(--font-poster);
    font-size: 4.4rem; line-height: 0.74;
    color: var(--ox);
    padding: 0.5rem 0.6rem 0 0;
    margin-top: 4px;
  }

  .rec__points { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 1.4rem; }
  .rec__point {
    display: grid; grid-template-columns: auto 1fr; gap: 1.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .rec__point-no {
    font-family: var(--font-poster);
    font-size: 1.6rem; color: var(--ink);
    line-height: 1; opacity: 0.85;
  }
  .rec__point h3 {
    font-family: var(--font-condensed); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.03em;
    font-size: 1.22rem; color: var(--ink); margin-bottom: 0.3rem;
  }
  .rec__point p { color: var(--ink-text); font-size: 0.98rem; }

  @media (max-width: 880px) {
    .rec__grid { grid-template-columns: 1fr; }
    .rec__media { max-width: 540px; }
  }
</style>
