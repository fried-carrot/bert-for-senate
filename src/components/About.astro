---
const points = [
  {
    n: '01',
    title: 'Proven Leadership',
    body: 'A combat-decorated officer who rose to Major General, with a record of leadership tested in service to the nation, not in the comfort of a campaign trail.',
  },
  {
    n: '02',
    title: 'Virginia Values',
    body: 'Committed to the principles that make Virginia strong: faith, family, and the freedom of every citizen to build a life on their own terms.',
  },
  {
    n: '03',
    title: 'Conservative Vision',
    body: 'A clear plan for lower taxes, limited government, and individual liberty, so opportunity is earned and protected for the next generation.',
  },
];
---

<section class="about section" id="about">
  <div class="container--wide about__grid">
    <div class="about__media" data-reveal>
      <div class="about__frame">
        <img
          src="/img/ceremony.jpg"
          alt="Bert Mizusawa speaking at a military ceremony"
          width="1920"
          height="1277"
          loading="lazy"
        />
      </div>
      <div class="about__plaque">
        <span class="about__plaque-num">34</span>
        <span class="about__plaque-label">Years defending<br />the country he loves</span>
      </div>
    </div>

    <div class="about__copy">
      <p class="eyebrow" data-reveal>Fighting for Virginia</p>
      <h2 class="display about__title" data-reveal data-reveal-delay="1">
        Leadership earned the hard way.
      </h2>
      <p class="lede about__lede" data-reveal data-reveal-delay="2">
        Decades of service to our nation taught Bert that real leadership is
        measured by results and sacrifice, not slogans. He brings that same
        commitment to the fight for Virginia families.
      </p>

      <ul class="about__points">
        {points.map((p, i) => (
          <li class="about__point" data-reveal data-reveal-delay={String(i + 2)}>
            <span class="about__point-n">{p.n}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about { background: var(--paper-2); position: relative; }
  .about__grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  .about__media { position: relative; }
  .about__frame {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--line);
  }
  .about__frame::after {
    content: "";
    position: absolute; inset: 0;
    background: linear-gradient(200deg, transparent 55%, rgba(13,39,66,0.35));
  }
  .about__frame img {
    width: 100%; height: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }
  .about__plaque {
    position: absolute;
    right: clamp(-0.5rem, 1vw, 1.25rem);
    bottom: -1.75rem;
    display: flex; align-items: center; gap: 0.9rem;
    background: var(--navy);
    color: var(--white);
    padding: 1.1rem 1.4rem;
    border-radius: 5px;
    box-shadow: var(--shadow-lift);
    border-left: 4px solid var(--red);
  }
  .about__plaque-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3rem;
    line-height: 1;
    color: var(--gold);
  }
  .about__plaque-label {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-navy-soft);
    line-height: 1.35;
  }

  .about__title {
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.5rem);
    color: var(--navy);
    margin: 1rem 0 1.25rem;
  }
  .about__lede { max-width: 46ch; margin-bottom: 2.5rem; }

  .about__points { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .about__point {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .about__point:last-child { border-bottom: 0; padding-bottom: 0; }
  .about__point-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--red);
    padding-top: 0.2rem;
    letter-spacing: 0.04em;
  }
  .about__point h3 {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.12rem;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }
  .about__point p { color: var(--text-soft); font-size: 0.98rem; }

  @media (max-width: 900px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__media { max-width: 540px; }
    .about__plaque { bottom: -1.25rem; }
  }
</style>
