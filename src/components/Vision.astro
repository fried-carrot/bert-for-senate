---
---

<section class="pledge section" id="vision">
  <div class="container pledge__inner" data-reveal>
    <div class="pledge__box">
      <span class="pledge__star pledge__star--tl" aria-hidden="true">&#9733;</span>
      <span class="pledge__star pledge__star--tr" aria-hidden="true">&#9733;</span>
      <span class="pledge__star pledge__star--bl" aria-hidden="true">&#9733;</span>
      <span class="pledge__star pledge__star--br" aria-hidden="true">&#9733;</span>

      <p class="eyebrow eyebrow--ink pledge__kicker">The Pledge</p>
      <blockquote class="pledge__quote">
        I took an oath to defend this country once. I am asking Virginia for the
        chance to keep that oath in the United States Senate &mdash; with
        <em>strong, principled leadership</em> that answers to you, and to no one else.
      </blockquote>
      <div class="pledge__sign">
        <span class="pledge__name">Bert Mizusawa</span>
        <span class="pledge__role">Maj. Gen., U.S. Army (Ret.) &middot; Candidate for U.S. Senate</span>
      </div>
    </div>
  </div>
</section>

<style>
  .pledge { background: var(--paper-2); position: relative; }
  .pledge__inner { max-width: 920px; }

  .pledge__box {
    position: relative;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ox), 10px 10px 0 3px var(--ink);
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.75rem, 5vw, 4rem);
    text-align: center;
  }
  .pledge__box::after {
    content: "";
    position: absolute; inset: 10px;
    border: 1px solid var(--line-strong);
    pointer-events: none;
  }
  .pledge__star {
    position: absolute; color: var(--ox); font-size: 1.1rem; z-index: 1;
  }
  .pledge__star--tl { top: 14px; left: 16px; }
  .pledge__star--tr { top: 14px; right: 16px; }
  .pledge__star--bl { bottom: 14px; left: 16px; }
  .pledge__star--br { bottom: 14px; right: 16px; }

  .pledge__kicker { justify-content: center; position: relative; z-index: 2; }
  .pledge__quote {
    position: relative; z-index: 2;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.45rem, 1rem + 2.4vw, 2.6rem);
    line-height: 1.3;
    color: var(--ink);
    margin: 1.5rem auto 2rem;
    max-width: 24ch;
    text-wrap: balance;
  }
  .pledge__quote em { font-style: italic; color: var(--ox); }
  .pledge__sign { position: relative; z-index: 2; }
  .pledge__name {
    display: block;
    font-family: var(--font-poster);
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    color: var(--ink);
    text-transform: uppercase;
    line-height: 1;
  }
  .pledge__role {
    display: block; margin-top: 0.6rem;
    font-family: var(--font-condensed); font-weight: 600;
    font-size: 0.82rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ox);
  }
</style>
