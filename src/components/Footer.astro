---
const nav = [
  { href: '#about', label: 'About Bert' },
  { href: '#issues', label: 'Where I Stand' },
  { href: '#vision', label: 'The Vision' },
  { href: '#act', label: 'Get Involved' },
];
const donate = 'https://secure.winred.com/';
---

<footer class="foot">
  <div class="stripe-rule" aria-hidden="true"></div>
  <div class="container--wide foot__grid">
    <div class="foot__brand">
      <a href="#top" class="foot__logo" aria-label="Bert Mizusawa for U.S. Senate">
        <span class="foot__star">&#9733;</span>
        <span>
          <strong>BERT MIZUSAWA</strong>
          <em>For U.S. Senate &middot; Virginia</em>
        </span>
      </a>
      <p class="foot__tag">
        Proven leadership for Virginia's families, veterans, and future.
      </p>
      <div class="foot__social">
        <a href="https://facebook.com/BertForSenate2026" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-3h2V9.7c0-2 1.2-3.1 3-3.1.9 0 1.8.1 1.8.1v2h-1c-1 0-1.3.6-1.3 1.2V12h2.3l-.4 3h-1.9v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href="https://instagram.com/bertforsenate2026" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>

    <nav class="foot__col" aria-label="Footer">
      <h4>Campaign</h4>
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="foot__col">
      <h4>Get Involved</h4>
      <a href={donate} target="_blank" rel="noopener">Donate</a>
      <a href="#act">Volunteer</a>
      <a href="mailto:info@bertforsenate.com">info@bertforsenate.com</a>
    </div>

    <div class="foot__col foot__join">
      <h4>Stay in the fight</h4>
      <p>Get campaign updates and ways to help.</p>
      <a href={donate} class="btn btn--sm" target="_blank" rel="noopener">Join the Campaign</a>
    </div>
  </div>

  <div class="container--wide foot__legal">
    <p class="foot__paid">Paid for by Bert for Senate 2026.</p>
    <div class="foot__links">
      <a href="#top">Privacy Policy</a>
      <a href="#top">Terms &amp; Conditions</a>
    </div>
    <p class="foot__disclaimer">
      Use of military rank, job titles, and photographs in uniform does not
      imply endorsement by the Department of the Army or the Department of Defense.
    </p>
  </div>
</footer>

<style>
  .foot { background: var(--ink); color: var(--on-navy-soft); }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2.5rem;
  }

  .foot__logo { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .foot__star {
    width: 38px; height: 38px; display: grid; place-items: center;
    background: var(--red); border-radius: 3px; color: var(--white); flex-shrink: 0;
  }
  .foot__logo strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800; letter-spacing: 0.02em;
    color: var(--white); font-size: 1rem;
  }
  .foot__logo em {
    font-style: normal; font-size: 0.66rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--on-navy-soft);
  }
  .foot__tag { font-size: 0.92rem; max-width: 34ch; margin-bottom: 1.25rem; }
  .foot__social { display: flex; gap: 0.6rem; }
  .foot__social a {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 1px solid var(--on-navy-line); border-radius: 4px;
    color: var(--on-navy-soft);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .foot__social a:hover { color: var(--white); background: var(--red); border-color: var(--red); }

  .foot__col h4 {
    font-family: var(--font-display);
    font-weight: 700; font-size: 0.78rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 1.1rem;
  }
  .foot__col a {
    display: block;
    font-size: 0.94rem; color: var(--on-navy-soft);
    padding: 0.4rem 0;
    transition: color 0.2s var(--ease), padding 0.2s var(--ease);
  }
  .foot__col a:not(.btn):hover { color: var(--white); padding-left: 4px; }
  .foot__join p { font-size: 0.92rem; margin-bottom: 1rem; }
  .foot__join .btn { margin-top: 0.25rem; }

  .foot__legal {
    border-top: 1px solid var(--on-navy-line);
    padding-block: 1.75rem 2.5rem;
    display: grid;
    gap: 0.75rem;
    font-size: 0.8rem;
  }
  .foot__legal { grid-template-columns: 1fr auto; align-items: center; }
  .foot__paid { font-weight: 600; color: var(--on-navy); letter-spacing: 0.02em; }
  .foot__links { display: flex; gap: 1.5rem; }
  .foot__links a { color: var(--on-navy-soft); transition: color 0.2s var(--ease); }
  .foot__links a:hover { color: var(--white); }
  .foot__disclaimer {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1.5;
    max-width: 70ch;
  }

  @media (max-width: 820px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .foot__grid { grid-template-columns: 1fr; }
    .foot__legal { grid-template-columns: 1fr; }
  }
</style>
