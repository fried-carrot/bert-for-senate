---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: '#about', label: 'The Record' },
  { href: '#issues', label: 'The Platform' },
  { href: '#vision', label: 'The Pledge' },
  { href: `${base}volunteer`, label: 'Volunteer' },
];
const donate = 'https://secure.winred.com/bert-for-senate/donate-today';
---

<footer class="colo">
  <div class="container--wide colo__top">
    <span class="colo__star" aria-hidden="true">&#9733;</span>
    <p class="poster colo__motto">Service Before Self</p>
    <span class="colo__star" aria-hidden="true">&#9733;</span>
  </div>

  <div class="container--wide colo__grid">
    <div class="colo__brand">
      <a href="#top" class="colo__logo" aria-label="Bert Mizusawa for U.S. Senate">
        <span class="colo__seal" aria-hidden="true">&#9733;&#9733;</span>
        <span>
          <strong>BERT MIZUSAWA</strong>
          <em>For U.S. Senate &middot; Virginia</em>
        </span>
      </a>
      <p class="colo__tag">Proven leadership for Virginia&rsquo;s families, veterans, and future.</p>
      <div class="colo__social">
        <a href="https://facebook.com/BertForSenate2026" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7h-2v-3h2V9.7c0-2 1.2-3.1 3-3.1.9 0 1.8.1 1.8.1v2h-1c-1 0-1.3.6-1.3 1.2V12h2.3l-.4 3h-1.9v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href="https://instagram.com/bertforsenate2026" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>

    <nav class="colo__col" aria-label="Footer">
      <h4>The Paper</h4>
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="colo__col">
      <h4>Take Action</h4>
      <a href={donate} target="_blank" rel="noopener">Donate</a>
      <a href={`${base}volunteer`}>Volunteer</a>
      <a href="mailto:info@bertforsenate.com">info@bertforsenate.com</a>
    </div>

    <div class="colo__col colo__join">
      <h4>Muster In</h4>
      <p>Get campaign dispatches and ways to help.</p>
      <a href={donate} class="btn btn--sm" target="_blank" rel="noopener">Join the Ranks</a>
    </div>
  </div>

  <div class="container--wide colo__legal">
    <p class="colo__paid">Paid for by Bert for Senate 2026.</p>
    <div class="colo__links">
      <a href="#top">Privacy Policy</a>
      <a href="#top">Terms &amp; Conditions</a>
    </div>
    <p class="colo__disc">
      Use of military rank, job titles, and photographs in uniform does not imply
      endorsement by the Department of the Army or the Department of Defense.
    </p>
  </div>
</footer>

<style>
  .colo { background: var(--ink); color: var(--on-ink-soft); }

  .colo__top {
    display: flex; align-items: center; gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line-cream);
  }
  .colo__top .colo__star { color: var(--ochre-2); }
  .colo__motto {
    font-size: clamp(1.3rem, 1rem + 2vw, 2.4rem);
    color: var(--paper);
    text-align: center; flex: 1;
    text-shadow: 3px 3px 0 var(--ox);
  }

  .colo__grid {
    display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2.5rem;
  }
  .colo__logo { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
  .colo__seal {
    display: grid; place-items: center; width: 40px; height: 40px;
    background: var(--ox); color: var(--paper); border: 2px solid var(--paper);
    font-size: 0.8rem; letter-spacing: -2px; transform: rotate(-3deg); flex-shrink: 0;
  }
  .colo__logo strong {
    display: block; font-family: var(--font-condensed); font-weight: 900;
    font-size: 1.15rem; color: var(--paper); letter-spacing: 0.01em;
  }
  .colo__logo em {
    font-style: normal; font-family: var(--font-condensed); font-weight: 600;
    font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ochre-2);
  }
  .colo__tag { font-family: var(--font-body); font-size: 0.95rem; max-width: 32ch; margin-bottom: 1.25rem; }
  .colo__social { display: flex; gap: 0.6rem; }
  .colo__social a {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 2px solid var(--line-cream); color: var(--on-ink-soft);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .colo__social a:hover { color: var(--paper); background: var(--ox); border-color: var(--ox); }

  .colo__col h4 {
    font-family: var(--font-condensed); font-weight: 800;
    font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ochre-2); margin-bottom: 1.1rem;
  }
  .colo__col a {
    display: block; font-family: var(--font-body); font-size: 0.96rem;
    color: var(--on-ink-soft); padding: 0.4rem 0;
    transition: color 0.2s var(--ease), padding 0.2s var(--ease);
  }
  .colo__col a:not(.btn):hover { color: var(--paper); padding-left: 5px; }
  .colo__join p { font-family: var(--font-body); font-size: 0.93rem; margin-bottom: 1rem; }
  .colo__join .btn { display: flex; justify-content: center; width: 100%; }

  .colo__legal {
    border-top: 1px solid var(--line-cream);
    padding-block: 1.75rem 2.5rem;
    display: grid; grid-template-columns: 1fr auto; align-items: center;
    gap: 0.75rem;
    font-family: var(--font-condensed); font-weight: 600;
    font-size: 0.82rem; letter-spacing: 0.04em;
  }
  .colo__paid { color: var(--paper); text-transform: uppercase; letter-spacing: 0.08em; }
  .colo__links { display: flex; gap: 1.5rem; }
  .colo__links a { color: var(--on-ink-soft); transition: color 0.2s var(--ease); }
  .colo__links a:hover { color: var(--paper); }
  .colo__disc {
    grid-column: 1 / -1; color: var(--on-ink-soft); opacity: 0.7;
    font-weight: 600; font-size: 0.72rem; letter-spacing: 0.02em;
    text-transform: none; line-height: 1.5; max-width: 72ch;
  }

  @media (max-width: 820px) { .colo__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) {
    .colo__grid { grid-template-columns: 1fr; }
    .colo__legal { grid-template-columns: 1fr; }
  }
</style>
