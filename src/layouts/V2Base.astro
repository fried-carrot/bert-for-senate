---
import '../styles/v2.css';

interface Props { title?: string; description?: string; }
const {
  title = 'Bert Mizusawa for U.S. Senate — Virginia',
  description = 'Maj. Gen. Bert Mizusawa (Ret.) — thirty-four years in uniform, now standing for the United States Senate from Virginia. Duty kept, not promised.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const ogImage = new URL(`${base}img/candidate.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon-v2.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16191f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Mark JS present before paint so reveal start-states never flash for no-JS/headless -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- Bronze tritone duotone: charcoal shadows, bronze mids, bone highlights -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <filter id="v2-bronze" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix"
            values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR tableValues="0.070 0.450 0.945" />
            <feFuncG tableValues="0.086 0.330 0.918" />
            <feFuncB tableValues="0.120 0.180 0.870" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <a href="#main" class="sr-only">Skip to content</a>
    <slot />

    <script>
      const els = document.querySelectorAll('.rise');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
