---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Bert Mizusawa for U.S. Senate — Virginia',
  description = 'Maj. Gen. Bert Mizusawa (Ret.) is running for the United States Senate to defend Virginia\'s values and secure America\'s future. Duty, country, and proven leadership.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#19223a" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/candidate.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800;900&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Ultra&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Duotone screenprint filters -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <filter id="duotone-ink" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix"
            values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR tableValues="0.075 0.945" />
            <feFuncG tableValues="0.110 0.902" />
            <feFuncB tableValues="0.205 0.804" />
          </feComponentTransfer>
        </filter>
        <filter id="duotone-ox" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix"
            values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0" />
          <feComponentTransfer>
            <feFuncR tableValues="0.235 0.945" />
            <feFuncG tableValues="0.060 0.902" />
            <feFuncB tableValues="0.040 0.804" />
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <a href="#main" class="sr-only">Skip to content</a>
    <div class="sheet">
      <div class="sheet__in">
        <slot />
      </div>
    </div>

    <style>
      /* Broadside frame as a flow wrapper: content lives inside, never clipped */
      .sheet {
        margin: 9px;
        padding: 4px;
        background: var(--paper);
        outline: 2px solid var(--ink);
        outline-offset: 0;
      }
      .sheet__in {
        outline: 1px solid var(--ink);
        outline-offset: 0;
      }
      @media (max-width: 640px) {
        .sheet { margin: 5px; padding: 3px; }
      }
    </style>

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
